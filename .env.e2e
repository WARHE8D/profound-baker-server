# Values for the end-to-end stack (docker-compose.e2e.yml), passed with `--env-file .env.e2e`.
# Test-only and committed on purpose: none of these are secrets. The Owner's must match
# profound-baker-web's e2e/support/env.ts.

# --- The throwaway database (in memory)
DB_NAME=baker
DB_USERNAME=baker
DB_PASSWORD=baker-e2e

# --- The Owner the tests sign in as. Created on an empty database; on a copy of production, the real
# Owner's login is changed to this one (infra/e2e/restore.sh).
APP_OWNER_EMAIL=owner@e2e.test
APP_OWNER_INITIAL_PASSWORD=e2e-owner-password
APP_OWNER_TIME_ZONE=America/New_York

# --- Which copy of production to load. Default: the newest baker-*.dump in ./backups (none: start empty).
# E2E_BACKUP_DIR=./backups
# E2E_DUMP=baker-20261201T023000Z.dump

# --- Web app image tag (docker-compose.prod.yml); a commit SHA pins a build.
# WEB_IMAGE_TAG=latest

# --- Required by docker-compose.prod.yml but unused here (docker-compose.e2e.yml overrides or disables
# what reads them). Placeholders only.
APP_JWT_PRIVATE_KEY=unused-in-e2e
APP_CORS_ALLOWED_ORIGINS=unused-in-e2e
APP_DOMAIN=unused-in-e2e
GRAFANA_ADMIN_PASSWORD=unused-in-e2e
