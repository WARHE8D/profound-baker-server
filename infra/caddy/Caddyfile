# Public entry point. Caddy obtains and renews the TLS certificate for APP_DOMAIN automatically
# (use APP_DOMAIN=localhost to try it locally with Caddy's internal CA).
#
# One domain for the whole site: uploaded images straight from the uploads volume (mounted read-only),
# the API to the app, and every other path to the web app (profound-baker-web's image, which serves the
# SPA with its own CSP and cache headers). Same origin, so the browser needs no CORS. Actuator (port
# 9080) is never routed, so it stays internal.

{$APP_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# handle_path strips /uploads, so /uploads/items/x.png maps to /srv/uploads/items/x.png. No "browse",
	# so directories are never listed. Filenames are random UUIDs that are never rewritten: cache forever.
	# The CSP stops a file from running script even if it is opened directly.
	handle_path /uploads/* {
		root * /srv/uploads
		header Cache-Control "public, max-age=31536000, immutable"
		header Content-Security-Policy "default-src 'none'; sandbox"
		file_server
	}

	# The API: its endpoints, the JWKS, and the OpenAPI spec the SPA's types are generated from.
	@api path /api/* /.well-known/* /v3/api-docs /v3/api-docs/* /swagger-ui.html /swagger-ui/*
	handle @api {
		reverse_proxy app:8080
	}

	# Everything else is the web app: its pages, assets, and index.html for client-side routes.
	handle {
		reverse_proxy web:80
	}
}
