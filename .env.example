# Copy to .env (git-ignored) and fill in real values. Never commit .env.
# Read by docker compose and, for local runs, by the Spring `dev` profile.
# In production, set the same variables in the server's environment instead.

# --- Database (docker compose creates the Postgres user/database from these on first start)
DB_NAME=baker-db
DB_USERNAME=baker
DB_PASSWORD=change-me
DB_URL=jdbc:postgresql://localhost:5432/baker-db

# --- Image storage (directory on local disk)
APP_STORAGE_PATH=./uploads

# --- CORS: origin(s) of the web SPA, comma-separated exact origins (no wildcards)
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Optional: hours before an unconfirmed order is auto-cancelled (default 24)
# APP_ORDER_PENDING_HOLD_HOURS=24

# --- Optional: internal Actuator port, never exposed through Caddy (default 9080)
# MANAGEMENT_PORT=9080

# --- Production only (docker-compose.prod.yml): public domain Caddy gets a TLS certificate for.
# Use localhost to try the prod stack locally.
APP_DOMAIN=localhost

# --- The Owner, created on first start when none exists (there is no signup endpoint). Without an
# Owner and without these the app refuses to start. Password: at least 12 characters. Once the Owner
# exists, change the password after logging in and remove APP_OWNER_INITIAL_PASSWORD.
APP_OWNER_EMAIL=owner@example.com
APP_OWNER_INITIAL_PASSWORD=change-me-on-first-login
# Optional: the bakery's IANA time zone for the new Owner (default UTC). Working hours and slots are local
# times in it. Change it later with PUT /api/owner/profile.
# APP_OWNER_TIME_ZONE=Europe/London

# --- Backups (docker-compose.prod.yml `backup` service; restore runbook in README.md). A pg_dump of the
# database and an archive of the uploads every night, kept BACKUP_RETENTION_DAYS on the server (in
# BACKUP_HOST_DIR) and in the off-box bucket. All optional; without a bucket, backups stay on the server.
# BACKUP_HOST_DIR=./backups
# Cron expression and the zone it is read in (default 02:30 UTC).
# BACKUP_SCHEDULE=30 2 * * *
# BACKUP_TZ=Europe/London
# BACKUP_RETENTION_DAYS=14
# Any S3-compatible storage (Backblaze B2, Cloudflare R2, Wasabi...). Backups contain guests' contact
# details, so they are only sent encrypted: BACKUP_ENCRYPTION_PASSWORD is required with a bucket. Keep it
# somewhere other than this server: without it the off-box copies cannot be restored.
# BACKUP_S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
# BACKUP_S3_REGION=auto
# BACKUP_S3_BUCKET=
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_ENCRYPTION_PASSWORD=

# --- Observability (docker-compose.prod.yml: Prometheus, Tempo, Grafana; README.md "Observability").
# Grafana listens on the server's loopback only; open it through an SSH tunnel:
#   ssh -L 3000:127.0.0.1:3000 <server>   then http://localhost:3000
GRAFANA_ADMIN_PASSWORD=change-me
# GRAFANA_ADMIN_USER=admin
# GRAFANA_PORT=3000
# How long Prometheus keeps metrics (default 30d). Traces are kept 7 days (infra/tempo/tempo.yaml).
# PROMETHEUS_RETENTION=30d

# --- JWT signing key (RS256) for the Owner's access tokens. Required in prod; when unset in dev a
# throwaway key is generated and tokens stop working on restart. PKCS#8 as one line of base64 DER:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 -outform DER | openssl base64 -A
# Changing it signs everyone out (access tokens fail validation; refresh tokens still work).
APP_JWT_PRIVATE_KEY=
