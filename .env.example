# Copy to .env (git-ignored) and fill in real values. Never commit .env.
# Read by docker compose and, for local runs, by the Spring `dev` profile.
# In production, set the same variables in the server's environment instead.

# --- Database (docker compose creates the Postgres user/database from these on first start)
DB_NAME=baker-db
DB_USERNAME=baker
DB_PASSWORD=change-me
DB_URL=jdbc:postgresql://localhost:5432/baker-db

# --- Image storage (directory on local disk)
APP_STORAGE_PATH=./uploads

# --- CORS: origin of the web SPA (enforced from #13)
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Optional: hours before an unconfirmed booking is auto-cancelled (default 24)
# APP_BOOKING_PENDING_HOLD_HOURS=24

# --- Optional: internal Actuator port, never exposed through Caddy (default 9080)
# MANAGEMENT_PORT=9080

# --- Production only (docker-compose.prod.yml): public domain Caddy gets a TLS certificate for.
# Use localhost to try the prod stack locally.
APP_DOMAIN=localhost

# JWT signing keys (RS256 key pair) arrive with #10.
